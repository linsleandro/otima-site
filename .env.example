# Copie para .env.local e preencha. NUNCA commitar chaves reais (CLAUDE.md §5).
# Em produção, configurar como variáveis de ambiente no painel da Vercel.

# Chave da API do Resend (envio dos formulários por e-mail)
RESEND_API_KEY=

# Remetente. Deixar vazio até verificar o domínio no Resend (usa onboarding@resend.dev).
# Depois da verificação: "Site Ótima <site@otimaconsultoria.com.br>"
FORMS_FROM_EMAIL=

# Destinatário das submissões
FORMS_TO_EMAIL=contato@otimaconsultoria.com.br
