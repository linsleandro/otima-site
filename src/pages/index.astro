---
import Base from '../layouts/Base.astro';

// Prova social — logos/nomes já usados no site atual (CLAUDE.md §7).
const clientes = ['Sebrae', 'SESC', 'SENAI', 'Fecomércio', 'CDL', 'Cruzeiro do Sul', 'Multiarte', 'Urano'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ótima Inteligência de Mercado',
  description:
    'Consultoria de pesquisa e inteligência de mercado com 21 anos de operação, sediada em Campo Grande/MS.',
  url: 'https://otimaconsultoria.com.br',
  email: 'contato@otimaconsultoria.com.br',
  telephone: '+556730154922',
  foundingDate: '2005',
  founder: { '@type': 'Person', name: 'Leandro Lins' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Campo Grande',
    addressRegion: 'MS',
    addressCountry: 'BR',
  },
  areaServed: 'BR',
};
---

<Base
  title="Ótima Inteligência de Mercado — Decisões sem achismo"
  description="Pesquisa e inteligência de mercado há 21 anos. Estudos para o Sistema S e órgãos públicos, e Parecer Estratégico para empresários PME. Campo Grande/MS."
  jsonLd={jsonLd}
>
  <!-- Hero neutro: apresenta, não vende (spec home.md §1) -->
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-cyan">Pesquisa e inteligência de mercado</p>
    <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-bold tracking-tight text-navy sm:text-5xl">
      Decisões sem achismo. Há 21 anos.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-navy-dark/80">
      A Ótima transforma dados primários em segurança para decidir — para instituições que precisam de rigor
      metodológico e para empresários que precisam de resposta.
    </p>
  </section>

  <!-- Duas portas: roteador de trilhas (spec home.md §2) -->
  <section aria-label="Escolha o seu perfil" class="mx-auto max-w-6xl px-4">
    <div class="grid gap-6 md:grid-cols-2">
      <a
        href="/institucional"
        class="group rounded-xl border border-navy/15 bg-white p-8 shadow-sm transition hover:border-navy hover:shadow-md"
      >
        <p class="text-xs font-semibold uppercase tracking-widest text-navy/60">Sistema S e setor público</p>
        <h2 class="mt-3 text-2xl font-bold text-navy">Sou Sistema S / órgão público</h2>
        <p class="mt-3 text-navy-dark/80">
          Pesquisa com rigor metodológico, fontes primárias e aderência a edital — do desenho amostral à
          apresentação para a diretoria.
        </p>
        <p class="mt-6 font-semibold text-navy group-hover:text-cyan">Conhecer a pesquisa institucional →</p>
      </a>
      <a
        href="/parecer-estrategico"
        class="group rounded-xl border border-navy/15 bg-cream p-8 shadow-sm transition hover:border-navy hover:shadow-md"
      >
        <p class="text-xs font-semibold uppercase tracking-widest text-navy/60">Empresas em decisão</p>
        <h2 class="mt-3 text-2xl font-bold text-navy">Sou empresário PME</h2>
        <p class="mt-3 text-navy-dark/80">
          Uma decisão travada — expansão, preço, concorrência — respondida com dado real, direto ao ponto.
        </p>
        <p class="mt-6 font-semibold text-navy group-hover:text-cyan">Conhecer o Parecer Estratégico →</p>
      </a>
    </div>
  </section>

  <!-- Prova social mista: só logos/nomes, sem aprofundar (spec home.md §3) -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="text-center text-sm font-semibold uppercase tracking-widest text-navy/50">
      Organizações que já contaram com a Ótima
    </p>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {
        clientes.map((cliente) => (
          <li class="text-lg font-semibold tracking-wide text-navy/40">{cliente}</li>
        ))
      }
    </ul>
  </section>

  <!-- Sobre em uma linha (spec home.md §4) -->
  <section class="border-t border-navy/10 bg-navy/[0.03]">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-12 text-center">
      <p class="max-w-2xl text-lg text-navy">
        21 anos de operação, mais de 500 empresas e instituições atendidas, a partir de Campo Grande/MS.
      </p>
      <a href="/sobre" class="font-semibold text-navy underline decoration-cyan decoration-2 underline-offset-4 hover:text-cyan">
        Conheça a Ótima e o Leandro Lins
      </a>
    </div>
  </section>
</Base>
