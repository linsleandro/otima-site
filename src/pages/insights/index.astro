---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formato = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' });
---

<Base
  title="Insights — Dados Sem Achismo | Ótima Inteligência de Mercado"
  description="Artigos sobre pesquisa de mercado, dados e decisão empresarial — o conteúdo da newsletter Dados Sem Achismo, de Leandro Lins, no domínio da Ótima."
>
  <section class="mx-auto max-w-4xl px-4 pb-10 pt-20">
    <p class="text-sm font-semibold uppercase tracking-widest text-cyan">Insights</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-navy">Dados Sem Achismo</h1>
    <p class="mt-4 max-w-2xl text-navy-dark/85">
      Análises sobre pesquisa, dados e decisão empresarial. Publicado também na newsletter
      <a
        href="https://dadossemachismo.substack.com"
        rel="noopener"
        class="underline decoration-cyan decoration-2 underline-offset-4">Dados Sem Achismo</a
      >, no Substack.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16">
    {
      posts.length === 0 ? (
        <div class="rounded-lg border border-navy/15 bg-navy/[0.03] p-8 text-center">
          <p class="text-navy-dark/80">
            Os artigos estão a caminho. Enquanto isso, leia as edições mais recentes direto na newsletter.
          </p>
          <a
            href="https://dadossemachismo.substack.com"
            rel="noopener"
            class="mt-4 inline-block rounded-md bg-navy px-6 py-3 font-semibold text-white transition hover:bg-navy-dark"
          >
            Ler no Substack
          </a>
        </div>
      ) : (
        <ul class="space-y-6">
          {posts.map((post) => (
            <li class="rounded-lg border border-navy/15 bg-white p-6 transition hover:border-navy">
              <a href={`/insights/${post.id}`}>
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-navy/60">
                  {formato.format(post.data.pubDate)}
                </time>
                <h2 class="mt-1 text-xl font-bold text-navy">{post.data.title}</h2>
                <p class="mt-2 text-navy-dark/80">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
